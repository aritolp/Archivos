📄 Pieza 1: El Cerebro (android/app/build.gradle.kts)
Este bloque es el que "conecta" tu código con las llaves secretas. Si Nowa te lo borra, pégalo de nuevo dentro del bloque android { ... }.



// 1. Esto va arriba de todo, fuera de 'android'
val keystorePropertiesFile = rootProject.file("key.properties")
val keystoreProperties = java.util.Properties()
if (keystorePropertiesFile.exists()) {
    keystoreProperties.load(java.io.FileInputStream(keystorePropertiesFile))
}

// 2. Esto va dentro de 'android'
android {
    signingConfigs {
        create("release") {
            keyAlias = keystoreProperties["keyAlias"] as? String
            keyPassword = keystoreProperties["keyPassword"] as? String
            storePassword = keystoreProperties["storePassword"] as? String
            val fileName = keystoreProperties["storeFile"] as? String
            if (fileName != null) {
                storeFile = file(fileName) // Busca en android/app/
            }
        }
    }

    buildTypes {
        getByName("release") {
            signingConfig = signingConfigs.getByName("release")
            // ... resto de config (minify, etc)
        }
    }
}



